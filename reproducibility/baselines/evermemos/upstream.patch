+        time_match = re.search(r'"time"\s*:\s*"((?:\\.|[^"\\])*)"', payload, re.DOTALL)
+        facts_key = re.search(r'"atomic_fact"\s*:\s*\[', payload)
+        if not time_match or not facts_key:
+            raise ValueError("Missing event_log.time or event_log.atomic_fact")
+
+        facts_start = facts_key.end()
+        depth = 1
+        facts_end = -1
+        for idx in range(facts_start, len(payload)):
+            ch = payload[idx]
+            if ch == '[':
+                depth += 1
+            elif ch == ']':
+                depth -= 1
+                if depth == 0:
+                    facts_end = idx
+                    break
+
+        if facts_end <= facts_start:
+            raise ValueError("Unable to locate atomic_fact list end")
+
+        facts_blob = payload[facts_start:facts_end]
+        facts: List[str] = []
+        for line in facts_blob.splitlines():
+            item = line.strip().rstrip(',')
+            if not item:
+                continue
+            if item.startswith('"') and item.endswith('"'):
+                item = item[1:-1]
+            else:
+                continue
+            item = item.replace('\\"', '"').replace('\\\\', '\\').strip()
+            if item:
+                facts.append(item)
+
+        if not facts:
+            raise ValueError("No atomic facts parsed")
+
+        time_value = time_match.group(1).replace('\\"', '"').replace('\\\\', '\\')
+        return {"event_log": {"time": time_value, "atomic_fact": facts}}
