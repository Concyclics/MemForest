+    def _parse_episode_fields_lenient(self, payload: str) -> Dict[str, Any] | None:
+        """
+        Extract episode fields from otherwise JSON-shaped output when quoted text
+        inside values is not escaped, e.g. Excel formulas containing "MM/DD/YYYY".
+        """
+
+        def extract_string_field(field: str, terminators: List[str]) -> str | None:
+            key_match = re.search(rf'"{field}"\s*:\s*"', payload)
+            if not key_match:
+                return None
+            start = key_match.end()
+            end_candidates = []
+            for terminator in terminators:
+                idx = payload.find(terminator, start)
+                if idx != -1:
+                    end_candidates.append(idx)
+            if not end_candidates:
+                return None
+            end = min(end_candidates)
+            value = payload[start:end]
