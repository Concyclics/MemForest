+def load_error_conversation_ids(run_dir: Path) -> list[str]:
+    """
+    Load failed conversation IDs from a previous EverMemOS run directory.
+
+    Expected files:
+        {run_dir}/memcells/errors/conv_*_error.json
+    """
+    errors_dir = run_dir / "memcells" / "errors"
+    if not errors_dir.exists():
+        return []
+
+    conversation_ids: list[str] = []
+    for error_file in sorted(errors_dir.glob("conv_*_error.json")):
+        try:
+            with open(error_file, "r", encoding="utf-8") as f:
+                payload = json.load(f)
+            conv_id = payload.get("conversation_id")
+            if conv_id:
+                conversation_ids.append(conv_id)
+        except Exception:
+            continue
+
+    # Deduplicate while preserving order
+    return list(dict.fromkeys(conversation_ids))
+
+
+def filter_dataset_by_conversation_ids(dataset, conversation_ids: list[str]):
+    """Restrict dataset to the specified conversation IDs."""
+    selected_ids = set(conversation_ids)
+    dataset.conversations = [
+        conv for conv in dataset.conversations if conv.conversation_id in selected_ids
+    ]
+    dataset.qa_pairs = [
+        qa
+        for qa in dataset.qa_pairs
+        if qa.metadata.get("conversation_id") in selected_ids
+    ]
+    return dataset
+
+
