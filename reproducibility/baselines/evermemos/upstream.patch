+    def _parse_event_log_lenient(self, response: str) -> Dict[str, Any]:
+        """
+        Best-effort parser for event_log JSON when an LLM leaves inner quotes
+        unescaped inside atomic_fact strings, e.g. a "super-nerd" phrase.
+        """
+        payload = self._extract_json_payload(response)
