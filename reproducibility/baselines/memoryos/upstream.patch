+class PerformanceLogger:
+    def __init__(self, log_dir, static_context=None):
+        self.log_dir = Path(log_dir)
+        self.log_dir.mkdir(parents=True, exist_ok=True)
+        self.llm_calls_path = self.log_dir / "llm_calls.jsonl"
+        self.stage_timings_path = self.log_dir / "stage_timings.jsonl"
+        self.static_context = static_context or {}
+        self._lock = threading.Lock()
+        self._local = threading.local()
+
+    def _now_iso(self):
+        return datetime.now(timezone.utc).isoformat()
+
+    def _get_stack(self):
+        stack = getattr(self._local, "stage_stack", None)
+        if stack is None:
+            stack = []
+            self._local.stage_stack = stack
+        return stack
+
+    def get_current_stage_context(self):
+        stack = self._get_stack()
+        return dict(stack[-1]) if stack else {}
+
+    def _write_jsonl(self, path, record):
+        with self._lock:
+            with open(path, 'a', encoding='utf-8') as f:
+                f.write(json.dumps(record, ensure_ascii=False) + "\n")
+
+    @contextmanager
+    def stage(self, stage, **metadata):
+        started_at = self._now_iso()
+        start_time = time.time()
+        context = {**self.static_context, **metadata, 'stage': stage}
+        stack = self._get_stack()
+        stack.append(context)
+        status = 'success'
