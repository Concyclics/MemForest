+def _extract_json_array(text):
+    text = (text or "").strip()
+    if text.startswith("```"):
+        text = re.sub(r"^```(?:json)?\s*", "", text)
+        text = re.sub(r"\s*```$", "", text).strip()
+    try:
+        return json.loads(text)
+    except Exception:
+        match = re.search(r"\[[\s\S]*\]", text)
+        if not match:
+            raise
+        return json.loads(match.group(0))
 
